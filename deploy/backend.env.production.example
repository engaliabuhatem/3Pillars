# 3 Pillars backend — PRODUCTION values.
# On the server: /srv/3pillars/backend/.env   (chmod 600, owner pillars)
# setup-server.sh fills in the domain and generates the secrets.

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=admin.example.com

# Data lives outside the git checkout so a pull can never touch it.
# Four slashes = absolute path. Swap for postgres://... when needed.
DATABASE_URL=sqlite:////var/lib/3pillars/db.sqlite3
MEDIA_ROOT=/var/lib/3pillars/assets
# CVs and proposal attachments: never served by nginx, staff download via the admin.
PRIVATE_MEDIA_ROOT=/var/lib/3pillars/private
CACHE_URL=filecache:///var/lib/3pillars/cache

CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=https://admin.example.com
SITE_URL=https://example.com
SECURE_SSL_REDIRECT=True
# nginx is the one proxy in front of gunicorn.
NUM_PROXIES=1

# Content webhook to the Next.js process on this machine (same secret both sides).
REVALIDATE_URL=http://127.0.0.1:3011/api/revalidate/
REVALIDATE_SECRET=

# Outgoing mail for enquiry notifications and auto-replies.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
NOTIFY_FROM_EMAIL=3 Pillars <no-reply@example.com>

# Cloudflare Turnstile secret (switch it on in Site settings too).
# TURNSTILE_SECRET_KEY=

# Turn on once every staff account has a TOTP device (Staff users → TOTP devices).
ADMIN_REQUIRE_2FA=False
