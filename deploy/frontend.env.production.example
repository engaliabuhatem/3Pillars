# 3 Pillars website — PRODUCTION values.
# On the server: /srv/3pillars/.env.production   (chmod 600, owner pillars)
# Read at build time and by systemd for `next start`.

SITE_URL=https://example.com

# The PUBLIC https address: image URLs are built from this host, and
# next/image refuses local IPs in production.
CMS_API_URL=https://admin.example.com/api
# Browsers post forms here (CORS is limited to the site's own origins).
NEXT_PUBLIC_CMS_API_URL=https://admin.example.com/api

# Shared with the backend's REVALIDATE_SECRET.
REVALIDATE_SECRET=

# The coming-soon switch is the checkbox in Site settings (live within ~10s).
# This is only the fallback if the CMS can't be reached: keep it true so an
# outage never exposes an unready site.
COMING_SOON=true

# Private preview while coming-soon is on: https://example.com/?preview=<token>
# (?preview=off to stop). Change it to revoke every preview cookie.
PREVIEW_TOKEN=
