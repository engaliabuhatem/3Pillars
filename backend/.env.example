# 3 Pillars backend. Copy to `.env` and fill in. `.env` is gitignored.

# ── Core ─────────────────────────────────────────────────────────────────
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (omit for local sqlite) ─────────────────────────────────────
# DATABASE_URL=postgres://user:password@host:5432/threepillars

# ── Files ────────────────────────────────────────────────────────────────
# MEDIA_ROOT=/var/lib/3pillars/assets          public uploads, served at /assets/
# PRIVATE_MEDIA_ROOT=/var/lib/3pillars/private CVs and RFP attachments, never public

# ── Frontend ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
SITE_URL=http://localhost:3000
# Revalidation webhook: same secret as REVALIDATE_SECRET in the frontend .env.
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# ── Email ────────────────────────────────────────────────────────────────
# Console backend while DEBUG=True. In production set SMTP:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
NOTIFY_FROM_EMAIL=3 Pillars <no-reply@localhost>

# ── Security ─────────────────────────────────────────────────────────────
# TURNSTILE_SECRET_KEY=        enable Turnstile in Site settings as well
# ADMIN_REQUIRE_2FA=True       only after every staff user has a TOTP device
# SECURE_SSL_REDIRECT=True
# CSRF_TRUSTED_ORIGINS=https://admin.3pillars.example

# Per-IP limit on form submissions. Raise only for local testing.
# FORM_THROTTLE_RATE=10/hour
