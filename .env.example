# 3 Pillars website (Next.js). Copy to `.env.local` for development.

# Public address of the site (canonical URLs, sitemap, OG images).
SITE_URL=http://localhost:3000

# The Django API, read by the server (data) and by browsers (form posts).
CMS_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_CMS_API_URL=http://127.0.0.1:8000/api

# Shared with backend/.env REVALIDATE_SECRET: lets the CMS refresh pages instantly.
REVALIDATE_SECRET=

# Coming-soon fallback when the CMS is unreachable, and the private preview token.
COMING_SOON=false
PREVIEW_TOKEN=

# Local production builds only: let next/image fetch from a CMS on 127.0.0.1.
# IMAGES_ALLOW_LOCAL_IP=true

# Show the hidden component styleguide (/en/_styleguide) in a production build.
# STYLEGUIDE=true
